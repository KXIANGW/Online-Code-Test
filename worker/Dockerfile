# --- Stage 1: build TypeScript ---
FROM --platform=$BUILDPLATFORM node:20-bookworm-slim AS node-build

WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY tsconfig.json ./
COPY src ./src
RUN npm run build

# --- Stage 2: build Isolate from source ---
# Isolate (sio2project) is a tiny C program (~5k lines). We build it from a
# pinned commit/tag for reproducibility, then carry only the binary forward.
# Also compiles oct-seccomp-wrapper in this stage so we keep all C build
# tooling in one place.
FROM debian:bookworm-slim AS isolate-build

ARG ISOLATE_REF=v2.0
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential \
      libcap-dev \
      libsystemd-dev \
      libseccomp-dev \
      pkg-config \
      asciidoc-base \
      git \
      ca-certificates \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
RUN git clone --depth 1 --branch ${ISOLATE_REF} https://github.com/ioi/isolate.git . \
 && make isolate isolate-cg-helper default.cf 2>/dev/null || make isolate

# Compile oct-seccomp-wrapper. Standalone binary that installs a seccomp-bpf
# filter and execve()'s the real candidate command — used by IsolateEngine
# to recover the syscall-blacklist layer that upstream isolate v2.0 lacks.
COPY sandbox/seccomp-wrapper/wrapper.c /src/oct-seccomp-wrapper.c
RUN gcc -O2 -Wall -o /usr/local/bin/oct-seccomp-wrapper \
      /src/oct-seccomp-wrapper.c -lseccomp

# --- Stage 3: runtime ---
FROM node:20-bookworm-slim

# Runtime deps:
#   - libcap2, libsystemd0 : needed by isolate
#   - libseccomp2          : needed by oct-seccomp-wrapper
#   - curl                 : healthcheck convenience
# (docker.io was needed by the legacy DockerEngine; removed in Step B.)
RUN apt-get update && apt-get install -y --no-install-recommends \
      libcap2 \
      libsystemd0 \
      libseccomp2 \
      curl \
 && rm -rf /var/lib/apt/lists/*

# Isolate is setuid-root; its config file path is hard-coded to
# /usr/local/etc/isolate.
#
# We override two fields from the v2.0 default:
#   - cg_root: skip isolate-cg-helper and point straight at the cgroup v2
#     unified hierarchy. Inside a container the runtime delegates a writable
#     subtree, so a fixed path works without a per-Node helper service.
#   - lock_root: keep at /run/isolate/locks (matches default; we just mkdir it).
COPY --from=isolate-build /src/isolate /usr/local/bin/isolate
RUN chmod 4755 /usr/local/bin/isolate \
 && mkdir -p /var/local/lib/isolate /run/isolate/locks /etc/oct \
 && printf '%s\n' \
      '# Generated by worker/Dockerfile — overrides isolate v2.0 default.cf' \
      'box_root = /var/local/lib/isolate' \
      'lock_root = /run/isolate/locks' \
      'cg_root = /sys/fs/cgroup' \
      'first_uid = 60000' \
      'first_gid = 60000' \
      'num_boxes = 256' \
    > /usr/local/etc/isolate

WORKDIR /app
ENV NODE_ENV=production

COPY package*.json ./
RUN npm ci --omit=dev
COPY --from=node-build /app/dist ./dist
COPY sandbox/languages.yaml ./sandbox/languages.yaml

# Seccomp bundle: wrapper binary + policy file colocated under /etc/oct so
# IsolateEngine can bind /etc/oct → /oct inside the sandbox in a single
# --dir rule. The wrapper applies the policy then execve()'s the candidate.
COPY sandbox/isolate-seccomp.policy /etc/oct/seccomp.policy
COPY --from=isolate-build /usr/local/bin/oct-seccomp-wrapper /etc/oct/seccomp-wrapper
RUN chmod 755 /etc/oct/seccomp-wrapper

# Entrypoint delegates cgroup v2 controllers so isolate --cg works.
COPY scripts/entrypoint.sh /usr/local/bin/oct-worker-entrypoint
RUN chmod 755 /usr/local/bin/oct-worker-entrypoint
ENTRYPOINT ["/usr/local/bin/oct-worker-entrypoint"]
CMD ["node", "dist/index.js"]
