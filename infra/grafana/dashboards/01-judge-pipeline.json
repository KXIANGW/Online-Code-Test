{
  "annotations": { "list": [] },
  "editable": false,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    { "title": "Load Balancing & Resilience", "type": "link", "url": "/d/oct-lb-resilience", "icon": "external link" },
    { "title": "API RED Overview", "type": "link", "url": "/d/oct-api-red", "icon": "external link" }
  ],
  "liveNow": true,
  "panels": [
    {
      "type": "stat",
      "title": "Queue depth (judge.tasks)",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rabbitmq_queue_messages{queue=\"judge.tasks\"})", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 20 } ] } } }
    },
    {
      "type": "stat",
      "title": "Judge in-flight",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [
        { "expr": "sum(judge_in_flight)", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 } ] } } }
    },
    {
      "type": "stat",
      "title": "Worker replicas",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [
        { "expr": "count(count by (worker) (judge_worker_info))", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null } ] } } }
    },
    {
      "type": "stat",
      "title": "Submit API p95 (s)",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{route=~\".*submissions\"}[1m])) by (le))", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 } ] } } }
    },
    {
      "type": "timeseries",
      "title": "Queue depth vs worker replicas (scaling correlation)",
      "id": 5,
      "description": "When the queue backs up, KEDA/HPA should scale workers; the two lines should track each other.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [
        { "expr": "sum(rabbitmq_queue_messages{queue=\"judge.tasks\"})", "refId": "A", "legendFormat": "queue depth", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
        { "expr": "count(count by (worker) (judge_worker_info))", "refId": "B", "legendFormat": "worker replicas", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "worker replicas" }, "properties": [ { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } } ] }
        ]
      }
    },
    {
      "type": "timeseries",
      "title": "Verdict rate (per second)",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [
        { "expr": "sum by (verdict) (rate(judge_verdicts_total[1m]))", "refId": "A", "legendFormat": "{{verdict}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 70, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "timeseries",
      "title": "Judge p50 / p95 / p99 by language (s)",
      "id": 7,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(judge_duration_seconds_bucket[1m])) by (le, language))", "refId": "p50", "legendFormat": "p50 {{language}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
        { "expr": "histogram_quantile(0.95, sum(rate(judge_duration_seconds_bucket[1m])) by (le, language))", "refId": "p95", "legendFormat": "p95 {{language}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
        { "expr": "histogram_quantile(0.99, sum(rate(judge_duration_seconds_bucket[1m])) by (le, language))", "refId": "p99", "legendFormat": "p99 {{language}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } } }
    },
    {
      "type": "timeseries",
      "title": "Submission created vs completed (per s)",
      "id": 8,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [
        { "expr": "sum by (type) (rate(submission_created_total[1m]))", "refId": "A", "legendFormat": "created {{type}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
        { "expr": "sum by (type) (rate(submission_completed_total[1m]))", "refId": "B", "legendFormat": "completed {{type}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Sandbox peak memory p95 by language (MB)",
      "id": 9,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "targets": [
        { "expr": "histogram_quantile(0.95, sum(rate(judge_memory_max_bytes_bucket[1m])) by (le, language)) / 1024 / 1024", "refId": "A", "legendFormat": "{{language}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "fillOpacity": 15 } } }
    },
    {
      "type": "timeseries",
      "title": "Worker pool CPU %",
      "id": 10,
      "description": "Per-worker process CPU (prom-client default metric); portable across compose and k3s.",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "targets": [
        { "expr": "sum by (worker) (rate(process_cpu_seconds_total{job=\"worker\"}[1m])) * 100", "refId": "A", "legendFormat": "{{worker}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "Worker pool memory (MB)",
      "id": 11,
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "targets": [
        { "expr": "process_resident_memory_bytes{job=\"worker\"} / 1024 / 1024", "refId": "A", "legendFormat": "{{worker}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "piechart",
      "title": "Verdict totals (cumulative)",
      "id": 12,
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 28 },
      "targets": [
        { "expr": "sum by (verdict) (last_over_time(judge_verdicts_total[1h]))", "refId": "A", "legendFormat": "{{verdict}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "pieType": "donut", "legend": { "displayMode": "table", "values": ["value"] } }
    },
    {
      "type": "timeseries",
      "title": "Worker desired vs current replicas (KEDA / HPA)",
      "id": 13,
      "description": "k3s only — sourced from kube-state-metrics. Shows KEDA scaling the worker pool against the judge queue.",
      "gridPos": { "h": 8, "w": 16, "x": 8, "y": 28 },
      "targets": [
        { "expr": "max(kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"oct\", horizontalpodautoscaler=~\".*worker.*\"})", "refId": "A", "legendFormat": "desired", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
        { "expr": "max(kube_horizontalpodautoscaler_status_current_replicas{namespace=\"oct\", horizontalpodautoscaler=~\".*worker.*\"})", "refId": "B", "legendFormat": "current", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stepAfter": true } } }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 39,
  "tags": ["oct", "judge", "scaling"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "OCT · Judge Pipeline & Scaling",
  "uid": "oct-judge-pipeline",
  "version": 1,
  "weekStart": ""
}
