  ],
  "liveNow": true,
  "panels": [
    {
      "type": "row",
      "title": "Traffic & Availability",
      "id": 100,
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "type": "text",
      "title": "How to read this board / node-down drill",
      "id": 1,
      "gridPos": { "h": 4, "w": 24, "x": 0, "y": 1 },
      "options": {
        "mode": "markdown",
        "content": "**Traffic path:** external IKM nginx (`upstream oct_frontend`, round-robin over the ikmlab + 9105 node entry ports) → NodePort 31000 → kube-proxy → frontend pod → backend ClusterIP → backend pod.\n\n**Is traffic going through the LB?** *Frontend ingress by node* (bar = total requests per node over the selected time range; the line panel = live req/s) is the faithful external nginx distribution — ingress is node-local via `externalTrafficPolicy=Local`. Per-request, `curl -I` shows `X-Frontend-Pod` and `X-Served-By: pod@node`.\n\n**Rows:** *Traffic & Availability* (this row) = operational view. Expand *Infrastructure Health* for node/pod/replica state, and *Node-Down Drill Monitor* during a drill.\n\n**Node-down drill:** `kubectl cordon <node>` then delete that node's pods. Expect: that node's bar/line → 0, the survivor absorbs it, *5xx ratio* stays flat, pods reschedule, replicas recover. (k3s-only; kube-state-metrics panels show *No data* under docker-compose.)"
      }
    },
    {
      "type": "stat",
      "title": "Total ingress requests (range)",
      "id": 15,
      "description": "Total requests that entered through the frontend over the selected time range.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum(increase(nginx_http_requests_total{job=\"frontend\"}[$__range]))", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 } }
    },
    {
      "type": "stat",
      "title": "Backend req/s (now)",
      "id": 5,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 5 },
      "targets": [
        { "expr": "sum(rate(http_request_duration_seconds_count{job=\"backend\"}[1m]))", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "reqps" } }
    },
    {
      "type": "stat",
      "title": "Online (live WS connections)",
      "id": 16,
      "description": "People currently connected to the live judge-result WebSocket stream (mostly candidates in an active session). 0 when nobody is watching results.",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 5 },
      "targets": [
        { "expr": "sum(ws_active_connections)", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "blue", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "type": "stat",
      "title": "Nodes Ready",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 5 },
      "targets": [
        { "expr": "sum(kube_node_status_condition{condition=\"Ready\", status=\"true\"})", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] } } }
    },
    {
      "type": "bargauge",
      "title": "Frontend ingress by node (requests, range)",
      "id": 17,
      "description": "Total frontend requests served by each node over the selected range — the external IKM nginx's actual load distribution. One bar per node; equal bars = even round-robin.",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 9 },
      "targets": [
        { "expr": "sum by (node) (increase(nginx_http_requests_total{job=\"frontend\"}[$__range]))", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "continuous-BlPu" } } }
    },
    {
      "type": "bargauge",
      "title": "Backend requests by node (range)",
      "id": 18,
      "description": "Total backend requests served by each node over the selected range (kube-proxy balances the ClusterIP across backend pods).",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 9 },
      "targets": [
        { "expr": "sum by (node) (increase(http_request_duration_seconds_count{job=\"backend\"}[$__range]))", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "displayMode": "gradient", "orientation": "horizontal", "showUnfilled": true, "valueMode": "color" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "continuous-GrYlRd" } } }
    },
    {
      "type": "timeseries",
      "title": "Frontend ingress req/s by node (live)",
      "id": 14,
      "description": "Live per-node request rate from the frontend nginx exporter. Under sustained load both nodes rise together; on node-down one drops to 0.",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 9 },
      "targets": [
        { "expr": "sum by (node) (rate(nginx_http_requests_total{job=\"frontend\"}[1m]))", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 30, "stacking": { "mode": "normal" } } } }
    },
    {
      "type": "row",
      "title": "Infrastructure Health",
      "id": 101,
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "panels": [
        {
          "type": "stat",
          "title": "Backend pods Ready",
          "id": 2,
          "gridPos": { "h": 4, "w": 6, "x": 0, "y": 18 },
          "targets": [
            { "expr": "sum(kube_pod_status_ready{namespace=\"oct\", condition=\"true\", pod=~\"backend.*\"})", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
          "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 } ] } } }
        },
        {
          "type": "stat",
          "title": "Frontend pods Ready",
          "id": 3,
          "gridPos": { "h": 4, "w": 6, "x": 6, "y": 18 },
          "targets": [
            { "expr": "sum(kube_pod_status_ready{namespace=\"oct\", condition=\"true\", pod=~\"frontend.*\"})", "refId": "A", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value" },
          "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 1 }, { "color": "green", "value": 2 } ] } } }
        },
        {
          "type": "state-timeline",
          "title": "Node Ready",
          "id": 9,
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
          "targets": [
            { "expr": "kube_node_status_condition{condition=\"Ready\", status=\"true\"}", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "options": { "showValue": "never", "mergeValues": true },
          "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "custom": { "fillOpacity": 80 } } }
        },
        {
          "type": "state-timeline",
          "title": "Pod Ready by node (backend / frontend)",
          "id": 8,
          "description": "Each row is a pod; gaps/red show the pod going NotReady when its node is cut, then rescheduling.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
          "targets": [
            { "expr": "kube_pod_status_ready{namespace=\"oct\", condition=\"true\", pod=~\"backend.*|frontend.*\"}", "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "options": { "showValue": "never", "mergeValues": true },
          "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }, "custom": { "fillOpacity": 80 } } }
        },
        {
          "type": "timeseries",
          "title": "Replicas: desired vs available (backend / frontend)",
          "id": 10,
          "description": "Available dips when a node dies and recovers as pods reschedule — demonstrates self-healing.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 30 },
          "targets": [
            { "expr": "kube_deployment_spec_replicas{namespace=\"oct\", deployment=~\"backend|frontend\"}", "refId": "A", "legendFormat": "desired {{deployment}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } },
            { "expr": "kube_deployment_status_replicas_available{namespace=\"oct\", deployment=~\"backend|frontend\"}", "refId": "B", "legendFormat": "available {{deployment}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10, "stepAfter": true } } }
        }
      ]
    },
    {
      "type": "row",
      "title": "Node-Down Drill Monitor",
      "id": 102,
      "collapsed": true,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": [
        {
          "type": "timeseries",
          "title": "Backend request rate by node",
          "id": 6,
          "description": "Backend serving spread across nodes (kube-proxy balances the ClusterIP). On node-down, the dead node's series drops to 0 and the survivor absorbs the load.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 19 },
          "targets": [
            { "expr": "sum by (node) (rate(http_request_duration_seconds_count{job=\"backend\"}[1m]))", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 30, "stacking": { "mode": "normal" } } } }
        },
        {
          "type": "timeseries",
          "title": "Backend request rate by pod",
          "id": 7,
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 19 },
          "targets": [
            { "expr": "sum by (pod) (rate(http_request_duration_seconds_count{job=\"backend\"}[1m]))", "refId": "A", "legendFormat": "{{pod}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
        },
        {
          "type": "timeseries",
          "title": "5xx error ratio by node",
          "id": 11,
          "description": "Should stay near zero during the node-down drill — proves the LB reroutes without user-visible errors.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 27 },
          "targets": [
            { "expr": "(sum by (node) (rate(http_request_duration_seconds_count{job=\"backend\", status=\"5xx\"}[1m])) or (sum by (node) (rate(http_request_duration_seconds_count{job=\"backend\"}[1m])) * 0)) / clamp_min(sum by (node) (rate(http_request_duration_seconds_count{job=\"backend\"}[1m])), 1)", "refId": "A", "legendFormat": "{{node}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "custom": { "drawStyle": "line", "fillOpacity": 20 } } }
        },
        {
          "type": "timeseries",
          "title": "Global p95 latency (during drill)",
          "id": 12,
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 27 },
          "targets": [
            { "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=\"backend\"}[1m])) by (le))", "refId": "A", "legendFormat": "p95", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
        },
        {
          "type": "timeseries",
          "title": "WebSocket connections by pod",
          "id": 13,
          "description": "Live judge-result push connections; shows clients re-balancing after a pod is lost.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 35 },
          "targets": [
            { "expr": "sum by (instance) (ws_active_connections)", "refId": "A", "legendFormat": "{{instance}}", "datasource": { "type": "prometheus", "uid": "oct-prometheus" } }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
        }
      ]
    }
  ],
