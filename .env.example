# ---- Postgres ----
POSTGRES_USER=oct
POSTGRES_PASSWORD=oct_dev_password_change_me
POSTGRES_DB=oct

# ---- Backend ----
# Backend reads DATABASE_URL inside the compose network.
# For local dev outside compose, override to point at localhost:5432.
DATABASE_URL=postgres://oct:oct_dev_password_change_me@postgres:5432/oct
JWT_SECRET=oct_dev_jwt_secret_change_me_32_chars
BACKEND_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# ---- RabbitMQ / Judge Worker ----
RABBITMQ_USER=oct
RABBITMQ_PASS=oct_dev_password
RABBITMQ_URL=amqp://oct:oct_dev_password@rabbitmq:5672
HOST_RABBITMQ_PORT=5672
HOST_RABBITMQ_MGMT_PORT=15672
HOST_WORK_DIR=/tmp/judge
# IsolateEngine config — only override if you know what you're doing.
# ROOTFS_BASE_DIR defaults to /var/lib/oct/rootfs (where `make
# build-isolate-rootfs` extracts the per-language images; K8s DaemonSet
# populates the same path in production).
# ROOTFS_BASE_DIR=/var/lib/oct/rootfs
# SECCOMP_BUNDLE_DIR defaults to /etc/oct (inside the worker image).
# SECCOMP_BUNDLE_DIR=/etc/oct

# ---- Frontend ----
# Host port that maps to the frontend nginx container.
FRONTEND_PORT=5173

# ---- Host-side port mappings (only used by docker-compose port mapping) ----
# Override these to avoid collisions with services already running on the host.
HOST_BACKEND_PORT=3000
HOST_POSTGRES_PORT=5432

# ---- Observability (Phase B) ----
HOST_PROMETHEUS_PORT=9090
HOST_CADVISOR_PORT=8081
HOST_GRAFANA_PORT=3001
HOST_RABBITMQ_PROM_PORT=15692
HOST_REDIS_PORT=6379
HOST_ADMINER_PORT=8082
